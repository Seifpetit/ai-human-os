{
  "drift_scoring": {
    "version": 1,
    "incident_score": {
      "formula": "severity_weight * confidence * scope_multiplier * persistence_multiplier * recoverability_multiplier",
      "severity_weights": {
        "critical": 40,
        "high": 25,
        "medium": 12
      },
      "confidence_range": {
        "min": 0.5,
        "max": 1.0
      },
      "scope_multipliers": {
        "single_file": 1.0,
        "cross_file": 1.3,
        "system_path": 1.6
      },
      "persistence_multipliers": {
        "first_seen": 1.0,
        "repeat_same_operation": 1.25,
        "repeat_across_runs": 1.5
      },
      "recoverability_multipliers": {
        "easy_auto_fix": 0.8,
        "needs_prompt_or_plan_fix": 1.1,
        "needs_architecture_change": 1.4
      }
    },
    "run_health": {
      "formula": "100 - open_drift_penalties - meta_state_penalties",
      "starting_score": 100,
      "meta_state_penalties": {
        "RETRY_LOOP": 15,
        "NON_CONVERGENCE": 25,
        "DETECTION_FAILURE": 30
      },
      "bands": [
        {
          "name": "healthy",
          "min": 90,
          "max": 100
        },
        {
          "name": "usable_with_issues",
          "min": 75,
          "max": 89
        },
        {
          "name": "unstable",
          "min": 50,
          "max": 74
        },
        {
          "name": "blocked",
          "min": 0,
          "max": 49
        }
      ]
    },
    "system_reliability": {
      "formula": "rolling_average(last_10_run_health_scores)",
      "window_size": 10
    },
    "hard_gates": {
      "block_run_if": [
        {
          "condition": "confirmed_critical_drift",
          "minimum_confidence": 0.8
        },
        {
          "condition": "DETECTION_FAILURE"
        }
      ]
    },
    "required_drift_fields": [
      "drift_type",
      "severity",
      "confidence",
      "scope",
      "stage",
      "operation_key",
      "first_seen_run",
      "repeat_count",
      "recoverability",
      "incident_score"
    ]
  }
}
